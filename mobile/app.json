{
  "expo": {
    "name": "Journaling App",
    "slug": "journal-app",
    "version": "1.0.0",
    "scheme": "journal-app",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.navya.journalapp"
    },
    "android": {
      "package": "com.navya.journalapp",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-asset",
      "expo-web-browser"
    ]
  }
}
